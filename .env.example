# Copy to .env on the server and fill in real values. Never commit .env
# Passwords must not contain single quotes (') : db/init/01-app-user.sh puts them inside SQL quotes

# MariaDB root (only the db container receives this)
DB_ROOT_PASSWORD=change-me-root

# App account: SELECT only on yongin, created on the db container's first start
DB_USERNAME=username
DB_PASSWORD=password

# CORS allowed origins, comma separated. Defaults to localhost:5173,localhost:3000 when unset
# 프론트 배포 주소 확정 시 추가, e.g.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yongyong-fe.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ML 설정
ML_DB_USERNAME=yongml
ML_DB_PASSWORD=yongml
LLM_PROVIDER=gemini

LLM_MODEL=
LLM_API_KEY=
LLM_RPM=10